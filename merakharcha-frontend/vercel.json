{
"version": 2,
"builds": [
{
"src": "next.config.js",
"use": "@vercel/next"
}
],
"routes": [
{
"src": "/_next/static/(.)",
"headers": {
"cache-control": "public, max-age=31536000, immutable"
},
"continue": true
},
{
"src": "/(.)",
"dest": "/$1"
}
],
"headers": [
{
"source": "/(.*)",
"headers": [
{
"key": "Strict-Transport-Security",
"value": "max-age=63072000; includeSubDomains; preload"
},
{
"key": "X-Content-Type-Options",
"value": "nosniff"
},
{
"key": "X-Frame-Options",
"value": "DENY"
}
]
}
],
"rewrites": [
{
"source": "/app-route-example",
"destination": "/api/app-route"
}
],
"cleanUrls": true
}
